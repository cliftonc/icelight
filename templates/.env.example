# icelight Environment Configuration
# Copy this file to .env and update values.
# `pnpm launch` writes ICELIGHT_PROJECT_NAME, ICELIGHT_API_TOKEN and
# ICELIGHT_INGEST_TOKEN here for you.

# ============================================
# Setup / Teardown (read by pnpm launch and pnpm teardown)
# ============================================

# Project name - resource names are derived from it
# (e.g. <project>-data bucket, <project>_events_stream, <project>-query-api worker)
ICELIGHT_PROJECT_NAME=icelight

# Cloudflare API token used for the Basin Catalog sink, Basin SQL and worker secrets
# Create at: https://dash.cloudflare.com/profile/api-tokens → Create Custom Token
# Account permissions (older dashboards: "Workers R2 Data Catalog" / "Workers R2 SQL"):
#   - Basin Catalog      → Edit
#   - Basin SQL          → Read
#   - Workers R2 Storage → Edit
#   - Workers Scripts    → Read
# Account Resources: include your account. See docs/configuration.md for details.
ICELIGHT_API_TOKEN=your-cloudflare-api-token

# Optional custom domain for the query API / web UI (the zone must be in your
# Cloudflare account). pnpm launch adds it as a Workers custom domain.
# ICELIGHT_QUERY_DOMAIN=analytics.example.com

# Ingest write key: generated by pnpm launch on first run and set as the ingest
# worker's AUTH_TOKEN and the query worker's INGEST_AUTH_TOKEN. Send it as the
# SDK writeKey or `Authorization: Bearer <token>`. Seeding sends it automatically.
# ICELIGHT_INGEST_TOKEN=ice_...

# Public demo: "true" lets anonymous visitors send events through the query
# API's /v1/* proxy (Event Simulator), limited to 20 requests/min per IP.
# Re-run pnpm launch after changing it.
# ICELIGHT_PUBLIC_DEMO=true

# ============================================
# Demo data (read by pnpm generate-events)
# ============================================

# Ingest worker URL to send generated events to (default: http://localhost:8787)
# INGEST_API_URL=https://icelight-event-ingest.<subdomain>.workers.dev
# (also sends ICELIGHT_INGEST_TOKEN from above)

# ============================================
# Worker settings (set as vars/secrets with wrangler, not read from .env)
# ============================================

# Ingest worker:
#   AUTH_ENABLED=true             # var: "false" turns ingest auth off
#   AUTH_TOKEN=...                # secret (set by pnpm launch from ICELIGHT_INGEST_TOKEN)
#   ALLOWED_ORIGINS=*             # var: comma-separated CORS origins
#
# Query worker:
#   CF_ACCOUNT_ID=...             # secret (set by pnpm launch)
#   CF_API_TOKEN=...              # secret (set by pnpm launch)
#   WAREHOUSE_NAME=<account-id>_<bucket>  # var (set by pnpm launch)
#   INGEST_AUTH_TOKEN=...         # secret (set by pnpm launch from ICELIGHT_INGEST_TOKEN)
#   PUBLIC_DEMO=true              # var (set by pnpm launch from ICELIGHT_PUBLIC_DEMO)
#   API_TOKEN=...                 # optional secret: require a Bearer token for queries, MCP and dashboards
#
# Rate limits are `ratelimits` bindings in each worker's wrangler.jsonc.
