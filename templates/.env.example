# icelight Environment Configuration
# Copy this file to .env and update values.
# `pnpm launch` writes ICELIGHT_PROJECT_NAME and ICELIGHT_API_TOKEN here for you.

# ============================================
# Setup / Teardown (read by pnpm launch and pnpm teardown)
# ============================================

# Project name - resource names are derived from it
# (e.g. <project>-data bucket, <project>_events_stream, <project>-query-api worker)
ICELIGHT_PROJECT_NAME=icelight

# Cloudflare API token used for the Basin Catalog sink, Basin SQL and worker secrets
# Create at: https://dash.cloudflare.com/profile/api-tokens → Create Custom Token
# Account permissions (older dashboards: "Workers R2 Data Catalog" / "Workers R2 SQL"):
#   - Basin Catalog      → Edit
#   - Basin SQL          → Read
#   - Workers R2 Storage → Edit
#   - Workers Scripts    → Read
# Account Resources: include your account. See docs/configuration.md for details.
ICELIGHT_API_TOKEN=your-cloudflare-api-token

# ============================================
# Demo data (read by pnpm generate-events)
# ============================================

# Ingest worker URL to send generated events to (default: http://localhost:8787)
# INGEST_API_URL=https://icelight-event-ingest.<subdomain>.workers.dev

# ============================================
# Worker settings (set as vars/secrets with wrangler, not read from .env)
# ============================================

# Ingest worker:
#   AUTH_ENABLED=false            # var: "true" to require an ingest token
#   AUTH_TOKEN=...                # secret: openssl rand -hex 32
#   ALLOWED_ORIGINS=*             # var: comma-separated CORS origins
#
# Query worker:
#   CF_ACCOUNT_ID=...             # secret (set by pnpm launch)
#   CF_API_TOKEN=...              # secret (set by pnpm launch)
#   WAREHOUSE_NAME=<account-id>_<bucket>  # var (set by pnpm launch)
#   API_TOKEN=...                 # optional secret: require a Bearer token for the query API
