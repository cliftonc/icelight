{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "icelight-event-ingest",
  "main": "src/index.ts",
  // 2025-01-01 or later is required for the Basin Pipelines send() method
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Environment variables (override in wrangler.toml or dashboard)
  "vars": {
    "AUTH_ENABLED": "false"
    // AUTH_TOKEN should be set as a secret: wrangler secret put AUTH_TOKEN
    // ALLOWED_ORIGINS can be set to comma-separated list of origins
  }

  // Basin Pipelines stream binding - added to wrangler.local.jsonc by: pnpm launch
  // "pipelines": [
  //   {
  //     "binding": "PIPELINE",
  //     "stream": "<YOUR_STREAM_ID>"
  //   }
  // ]
}
