{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "icelight-event-ingest",
  "main": "src/index.ts",
  // 2025-01-01 or later is required for the Basin Pipelines send() method
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Environment variables (override in wrangler.toml or dashboard)
  "vars": {
    // Requires a write key (Bearer, Basic username or X-API-Key) on every request.
    // pnpm launch generates AUTH_TOKEN and sets it as a secret
    // (wrangler secret put AUTH_TOKEN). Browser write keys are visible to anyone,
    // so the rate limit below is what bounds abuse.
    "AUTH_ENABLED": "true"
    // ALLOWED_ORIGINS can be set to comma-separated list of origins
  },

  // Per-IP rate limit (period must be 10 or 60 seconds). Every accepted event is
  // billed by Basin Pipelines and makes later Basin SQL scans bigger.
  // namespace_id is any integer, unique per rate limiter in your account.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "41001", "simple": { "limit": 300, "period": 60 } }
  ]

  // Basin Pipelines stream binding - added to wrangler.local.jsonc by: pnpm launch
  // "pipelines": [
  //   {
  //     "binding": "PIPELINE",
  //     "stream": "<YOUR_STREAM_ID>"
  //   }
  // ]
}
